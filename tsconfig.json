{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "alwaysStrict": true,
        "declaration": true,
        "declarationMap": true,
        "module": "nodenext",
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "outDir": "./out",
        "rootDir": "./src",
        "strict": true,
        "target": "esnext",
        "types": ["node"]
    },
    "exclude": ["./tests"]
}
